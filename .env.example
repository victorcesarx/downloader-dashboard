# WebScope - variáveis de ambiente (exemplo)
# Copie para `.env` e ajuste os valores.
# O `.env` é carregado automaticamente por server/config.js, sem sobrescrever
# variáveis já definidas no ambiente do sistema.

# Porta HTTP do servidor (deploy com certs/ dispõe de HTTPS automático).
PORT=3006

# Diretório gravável usado para ZIPs temporários. Em Docker, monte um volume
# dedicado neste caminho.
TEMP_DIR=./temp_zips

# Token opcional para autenticação (serve como senha para acessar a API).
DOWNDASH_TOKEN=

# Token de conta GoFile opcional. Reutilizar uma conta própria evita a criação
# repetida de contas guest e reduz bastante os limites por IP.
GOFILE_TOKEN=

# Override administrativo opcional. Vazio permite descoberta e validação
# automáticas a partir do frontend público atual do GoFile.
GOFILE_WT_SALT=

# Nível mínimo dos logs JSON: debug, info, warn ou error.
LOG_LEVEL=info

# Formato: auto usa saída compacta em desenvolvimento e JSON em produção.
LOG_FORMAT=auto

# ZIP: número máximo de arquivos aceitos por tarefa.
ZIP_MAX_ITEMS=200

# ZIP: timeout por tentativa de fetch (ms).
ZIP_FETCH_TIMEOUT_MS=30000

# ZIP: limite total de bytes baixados por tarefa em andamento (10 GB).
ZIP_MAX_TOTAL_BYTES=10737418240

# Limite total ocupado pelo diretório de ZIPs temporários (10 GB).
ZIP_MAX_TEMP_BYTES=10737418240

# ZIP: máximo de tarefas em andamento (queued + processing) por IP.
ZIP_MAX_TASKS_PER_IP=3

# Docker Compose: interface/porta publicadas no host e recursos do contêiner.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3006
WEBSCOPE_IMAGE_TAG=local
WEBSCOPE_MEMORY_LIMIT=1g
WEBSCOPE_CPU_LIMIT=1.0
WEBSCOPE_PIDS_LIMIT=200

# Docker Compose com proxy reverso: domínio usado pelo Caddy.
WEBSCOPE_DOMAIN=localhost
