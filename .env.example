# WebScope - variáveis de ambiente (exemplo)
# Copie para `.env` e ajuste os valores.
# O `.env` é carregado automaticamente por server/config.js, sem sobrescrever
# variáveis já definidas no ambiente do sistema.

# Porta HTTP do servidor (deploy com certs/ dispõe de HTTPS automático).
PORT=3006

# Token opcional para autenticação (serve como senha para acessar a API).
DOWNDASH_TOKEN=

# ZIP: número máximo de arquivos aceitos por tarefa.
ZIP_MAX_ITEMS=200

# ZIP: timeout por tentativa de fetch (ms).
ZIP_FETCH_TIMEOUT_MS=30000

# ZIP: limite total de bytes baixados por tarefa em andamento (20 GB).
ZIP_MAX_TOTAL_BYTES=21474836480

# ZIP: máximo de tarefas em andamento (queued + processing) por IP.
ZIP_MAX_TASKS_PER_IP=3