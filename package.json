{
  "name": "downloader-dashboard",
  "version": "1.1.0",
  "description": "WebScope - Web App for extracting and downloading media from any page",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server/production.js",
    "start:source": "node server.js",
    "dev": "node server/dev.js",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "check:build": "node server/check-build.js",
    "start:prod": "node server/production.js",
    "preview": "npm run build && npm run start:prod",
    "verify": "npm run test && npm run build && npm run check:build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "downloader",
    "dashboard",
    "media",
    "scraper",
    "zip"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
